<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="tech.foursee.stophero"
    android:versionCode="15" android:versionName="0.7.3">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
  <queries>
    <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.HOME"/></intent>
    <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.SECONDARY_HOME"/></intent>
  </queries>
  <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
      android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
    <activity android:name=".TopActivity" android:exported="true" android:launchMode="singleTask"
        android:screenOrientation="landscape"
        android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize|density|uiMode">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <activity android:name=".BottomActivity" android:exported="false" android:launchMode="singleTask"
        android:taskAffinity="tech.foursee.stophero.bottom" android:resizeableActivity="true"
        android:excludeFromRecents="true"
        android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize|density|uiMode"/>
  </application>
</manifest>
